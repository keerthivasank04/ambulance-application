# Copy this file to .env and fill in your values
PORT=5000

# Admin credentials — CHANGE THESE IN PRODUCTION
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=change-this-to-a-long-random-string-in-production

# Comma-separated list of allowed frontend origins (no trailing slashes).
# Local dev falls back to localhost:5173/3000/4173 if this is unset.
# In production, set this to your deployed frontend URL, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=

# GPS device API key — generated secret shared with Arduino firmware
GPS_API_KEY=arduino-bridge-secret

# Optional: JWT secret for future auth upgrades
# JWT_SECRET=your-secret-here
